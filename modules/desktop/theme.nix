# One Dark palette, shared by the terminal, launcher, bar, notifications,
# lock screen and GTK/Qt so the whole desktop looks like one product.
# VS Code ("One Dark Pro") and Zed ("One Dark") use the matching themes.
{
  bg = "#282c34";
  bgAlt = "#21252b";
  bgHighlight = "#3e4451";
  fg = "#abb2bf";
  fgBright = "#d7dae0";
  muted = "#5c6370";
  red = "#e06c75";
  green = "#98c379";
  yellow = "#e5c07b";
  blue = "#61afef";
  magenta = "#c678dd";
  cyan = "#56b6c2";
  orange = "#d19a66";

  # Font names as fontconfig sees them
  monoFont = "JetBrainsMono Nerd Font";
  uiFont = "Noto Sans";

  gtkTheme = "adw-gtk3-dark";
  iconTheme = "Papirus-Dark";
}
